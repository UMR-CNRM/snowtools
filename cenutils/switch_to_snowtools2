
SNOWTOOLS_CEN=$(realpath ${BASH_SOURCE}) | rev | cut -d/ -f3- | rev
export SNOWTOOLS_CEN="$SNOWTOOLS_CEN"
export PYTHONPATH=$SNOWTOOLS_CEN:${PYTHONPATH:- }

case hostname in
    "*hpc.meteo.fr")
        export VORTEX=~verolive/vortex/vortex-cen
        export MTOOLDIR=$WORKDIR
        ;;
    "sxcen")
        export VORTEX=~verolive/vortex/vortex-cen
        export MTOOLDIR=/cnrm/cen/users/NO_SAVE/$USER
        ;;
    "px*")
        export VORTEX=/rd/cenfic3/cenmod/home/lafaysse/common/vortex/vortex-cen
        export MTOOLDIR=$HOME
        ;;
    "*")
        export VORTEX=/d0/sync/vortex/vortex-cen
        export MTOOLDIR=/cnrm/cen/users/NO_SAVE/$USER
esac

export PYTHONPATH=$PYTHONPATH:$VORTEX/site:$VORTEX/src:$VORTEX/project

alias s2m="python $SNOWTOOLS_CEN/snowtools/tasks/s2m_command.py"
alias proplotter="python3 $SNOWTOOLS_CEN/snowtools/plots/stratiprofile/proplotter.py"
alias procompare="python3 $SNOWTOOLS_CEN/snowtools/plots/stratiprofile/procompare.py"
alias put="$SNOWTOOLS_CEN/cenutils/put"
